# ---------------------------------------------------------------------------
# ReferRail NEAR — copy to apps/web/.env.local and fill in.
# NEVER commit real keys. Testnet throwaway keys only.
# ---------------------------------------------------------------------------

# --- NEAR testnet (core demo) ----------------------------------------------
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_CONTRACT_ID=referrail-dev.testnet
NEAR_OWNER_ACCOUNT=referrail-dev.testnet
NEAR_TREASURY_ACCOUNT=referrail-dev.testnet

# --- Relayer (pays gas for creators' claims and sends release) -------------
# Multiple full-access keys avoid nonce collisions under load.
NEAR_RELAYER_ACCOUNT=rr-relayer.testnet
NEAR_RELAYER_PRIVATE_KEY=
NEAR_RELAYER_PRIVATE_KEYS=

# --- Demo NEP-141 token (contracts/test-ft) --------------------------------
NEAR_FT_ACCOUNT=usdc.referrail-dev.testnet
NEAR_FT_DECIMALS=6
NEAR_FT_SYMBOL=tUSDC
# Owner key for the demo faucet (testnet ONLY — never on mainnet).
FT_OWNER_ACCOUNT=
FT_OWNER_PRIVATE_KEY=

# --- Deploy / seed personas (throwaway testnet accounts) -------------------
NEAR_DEPLOYER_ACCOUNT=referrail-dev.testnet
NEAR_DEPLOYER_PRIVATE_KEY=
NEAR_BIZ_ACCOUNT=rr-biz.testnet
NEAR_BIZ_PRIVATE_KEY=
NEAR_CREATOR_ACCOUNT=rr-creator.testnet
NEAR_CREATOR_PRIVATE_KEY=
NEAR_BUYER_ACCOUNT=rr-buyer.testnet
NEAR_BUYER_PRIVATE_KEY=

# --- Demo signed actions (server-side keys for the seeded personas) --------
# Setting DEMO_MODE=yes lets the UI run a full sale without a wallet extension.
DEMO_MODE=yes
DEMO_MERCHANT_ACCOUNT=
DEMO_MERCHANT_PRIVATE_KEY=
DEMO_CREATOR_ACCOUNT=
DEMO_CREATOR_PRIVATE_KEY=
DEMO_BUYER_ACCOUNT=
DEMO_BUYER_PRIVATE_KEY=

# --- Agent (NEAR AI Cloud, OpenAI-compatible) ------------------------------
# Leave NEAR_AI_API_KEY empty to use the deterministic rules fallback.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=Qwen3-235B-A22B

# --- NEAR Intents / 1Click (MAINNET only; there is no testnet) -------------
INTENTS_API_BASE=https://1click.chaindefuser.com
INTENTS_JWT=
# Default dry. Set to "yes" only when you deliberately demo a tiny live swap.
CONFIRM_LIVE_INTENTS=no

# --- Public app ------------------------------------------------------------
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_CONTRACT_ID=referrail-dev.testnet
NEXT_PUBLIC_APP_URL=http://localhost:3000
